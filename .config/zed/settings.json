{
  "cli_default_open_behavior": "existing_window",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "toolbar": {
    "breadcrumbs": false,
    "quick_actions": false,
    "selections_menu": false,
  },
  "disable_ai": true,
  "restore_on_startup": "launchpad",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "base_keymap": "VSCode",
  "ui_font_size": 15.0,
  "ui_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 13.0,
  "relative_line_numbers": "enabled",
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Catppuccin Mocha"
  },
  "terminal": {
    "dock": "right",
    "font_size": 13.0,
    "toolbar": {
      "breadcrumbs": false
    },
    "shell": {
      "program": "fish"
    }
  },
  "title_bar": {
    "show_sign_in": false,
    "show_user_menu": false
  },
  "vim": {
    "use_system_clipboard": "always",
  },
  "indent_guides": {
    "enabled": true,
    "coloring": "indent_aware",
  },
  "tabs": {
    "show_diagnostics": "all",
    "file_icons": true,
    "git_status": true
  },
  "format_on_save": "off",
  "auto_install_extensions": {
    "html": true,
    "toml": true,
    "dockerfile": true,
    "lua": true,
    "git-firefly": true
  },
}
